# Configuración de ambiente
DEBUG=True
DATABASE_URL=postgresql://fichadas_user:fichadas_pass@localhost:5432/fichadas_db
SECRET_KEY=your-secret-key-here

# Configuración de archivos
CARPETA_SALIDA=/data/fichadas
CARPETA_BACKUP=/data/backup

# Configuración de tareas
FRECUENCIA_MINUTOS=5
INICIO_AUTOMATICO=True
MAX_REINTENTOS=3

# Configuración SMTP (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=admin@empresa.com
SMTP_USE_TLS=True

# Configuración SendGrid (opcional)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=noreply@empresa.com
SENDGRID_TO=admin@empresa.com

# Tipo de notificación: smtp, sendgrid o none
NOTIFICATION_TYPE=none

# Redis (para Celery - opcional)
REDIS_URL=redis://localhost:6379/0